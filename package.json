{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "backend/functions"
    ],
    "nohoist": [
      "**/@expo/**",
      "**/@react-native/**",
      "**/@react-navigation/**",
      "**/expo",
      "**/expo/**",
      "**/expo-av",
      "**/expo-asset",
      "**/expo-constants",
      "**/expo-font",
      "**/expo-haptics",
      "**/expo-image",
      "**/expo-linking",
      "**/expo-notifications",
      "**/expo-router",
      "**/expo-splash-screen",
      "**/expo-status-bar",
      "**/expo-symbols",
      "**/expo-system-ui",
      "**/expo-web-browser",
      "**/react",
      "**/react-dom",
      "**/react-native",
      "**/react-native/**",
      "**/react-native-gesture-handler",
      "**/react-native-reanimated",
      "**/react-native-safe-area-context",
      "**/react-native-screens",
      "**/react-native-web",
      "**/react-native-worklets",
      "**/@types/react",
      "**/eslint-config-expo"
    ]
  },
  "scripts": {
    "start": "node start.js",
    "emulators": "node start.js emulators",
    "emulators:restart": "sudo pkill -f \".*fire.*\" && sudo yarn emulators",
    "w": "yarn workspaces --parallel run",
    "dev": "firebase emulators:start --import=./firebase-emulator-data --export-on-exit=./firebase-emulator-data --only=functions,firestore,hosting & vite --debug",
    "check": "tsc --noEmit",
    "lint": "eslint backend/functions apps/player-app",
    "test": "vitest run",
    "test:jest": "jest --config jest.config.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "firebase deploy",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:all": "firebase deploy --only functions,hosting",
    "build": "yarn workspaces run build",
    "build:web": "yarn workspaces run build",
    "build:functions": "tsc --project backend/functions/tsconfig.json",
    "db:push": "drizzle-kit push",
    "prepare": "husky",
    "nuke": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && find . -name 'dist' -type d -prune -exec rm -rf '{}' + && yarn install",
    "venues": "yarn workspace venue-dashboard",
    "venues:start": "yarn workspace venue-dashboard start",
    "venues:dev": "yarn workspace venue-dashboard dev",
    "venues:build": "yarn workspace venue-dashboard build",
    "venues:test": "yarn workspace venue-dashboard test:selenium",
    "players": "yarn workspace player-app",
    "players:start": "yarn workspace player-app start",
    "players:dev": "node start.js",
    "players:build": "yarn workspace player-app build",
    "players:test": "yarn workspace player-app test:selenium"
  },
  "dependencies": {
    "@genkit-ai/firebase": "^1.22.0",
    "@genkit-ai/googleai": "^1.22.0",
    "@hookform/resolvers": "^3.10.0",
